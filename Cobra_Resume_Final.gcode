; === RECOVERY STARTUP SEQUENCE (NO HOMING) ===
M201 X2500 Y2500 Z500 E5000   ; Hardware acceleration constraints
M203 X250 Y250 Z5 E40         ; Max feedrates
M204 P2500 R500 T2500 
M205 X10.00 Y10.00 Z0.40 E5.00 ; Jerk limits

M220 S100 ; Reset Feedrate 
M221 S100 ; Reset Flowrate 
 
M140 S65  ; Heat Bed
M104 S220 ; Heat Nozzle
M190 S65  ; Wait for Bed temp
M109 S220 ; Wait for Nozzle temp

G90       ; Force Absolute positioning mode

; --- VIRTUAL COORDINATE SET ---
G92 Z69.600     ; Tells firmware it is exactly at 69.600mm

; Lifts nozzle 4mm safely clear above the printed object
G1 Z73.600 F3000 

M83       ; Force relative extrusion mode

; --- HOVER TRAVEL MOVE ---
; Moves the nozzle mid-air directly over your print resume position
G1 X148.701 Y161.46 F6000 

; Drops the nozzle straight down onto the model layer seamlessly
G1 Z69.600 F1200 
; === END OF RECOVERY STARTUP SEQUENCE ===
G1 F3000
G1 X148.701 Y161.46 E-.23095
G1 X148.345 Y161.498 E-.12905
;WIPE_END
